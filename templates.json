{
    "scope": "@app_/",
    "shell": [
        "package.json",
        "pnpm-workspace.yaml",
        "turbo.json",
        ".gitignore",
        ".gitattributes",
        ".editorconfig",
        ".oxlintrc.json",
        ".prettierignore",
        ".prettierrc.json",
        "commitlint.config.mjs",
        "docker-compose.yml",
        ".env.example",
        ".githooks"
    ],
    "shared": ["_tools/constants", "_tools/localhost-https", "_tools/scripts", "_tools/tsconfig"],
    "templates": {
        "api": {
            "label": "API (Hono)",
            "description": "Hono + oRPC API on Bun, with Prisma and Postgres.",
            "instance": ["_apps/api", "_libs/api-contract", "_libs/prisma"],
            "previews": [
                {
                    "package": "api",
                    "dev": "pnpm --filter {pkg} dev",
                    "port": 6480,
                    "env": { "API_PORT": "{port}", "WEB_ORIGIN": "{previewUrl:web}" }
                }
            ]
        },
        "web": {
            "label": "Web app (Vue)",
            "description": "Vue 3 SPA (Vite + Vue Router + TanStack Query) on the api's oRPC contract.",
            "instance": ["_apps/web", "_libs/api-contract"],
            "previews": [{ "package": "web", "dev": "pnpm --filter {pkg} dev", "port": 4701, "env": { "API_URL": "{previewUrl:api}" } }]
        }
    }
}
