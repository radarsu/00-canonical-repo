# Local development environment, copied to .env (git-ignored) by `pnpm install` when there is none. Read by the api's
# config (_apps/api/src/env.config.ts), Prisma's CLI (_libs/prisma/prisma.config.ts) and docker compose. A container gets
# the same names from its deployment instead.
#
# @puristic/env derives each name from the config schema path, SCREAMING_SNAKE-cased: database.url → DATABASE_URL,
# api.port → API_PORT. An empty value counts as unset, so the schema's default applies.
#
# Put every comment on its own line: the reader takes everything after the first "=" verbatim, so a trailing
# `# comment` becomes part of the value.

# Postgres, matching docker-compose.yml. Move POSTGRES_PORT and the port in DATABASE_URL together.
POSTGRES_PORT=5439
DATABASE_URL=postgresql://app:app@localhost:5439/app
DATABASE_POOL_MAX=

# The browser origin the web app is served from, the one origin the api's CORS admits.
WEB_ORIGIN=https://localhost:4701

# The api's listener. Standalone development serves https with the per-user certificate `pnpm install` mints (run
# `pnpm cert:trust` once to trust it); API_HTTPS_KEY / API_HTTPS_CERT point at another pair. The web dev server reads
# the api's address from $API_URL in its own shell (default https://localhost:6480), not from this file.
API_PORT=6480
API_HOST=
API_HTTPS_KEY=
API_HTTPS_CERT=

# Logging (pino). LOG_LEVEL: fatal|error|warn|info|debug|trace|silent. LOG_PRETTY: colorized lines (default outside
# production) or one JSON object per line.
LOG_LEVEL=info
LOG_PRETTY=
